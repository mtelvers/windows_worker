 }
 
+(* See day10_stubs.c: without these, the files opam's Cygwin writes inside a
+   container cannot be removed from the host, and the base build fails at
+   tidy with EACCES unless day10 happens to run from an OpenSSH session. *)
+external enable_backup_privileges : unit -> bool = "day10_enable_backup_privileges"
+
+let () =
+  if Sys.win32 && not (enable_backup_privileges ()) then
+    prerr_endline "Warning: SeBackupPrivilege/SeRestorePrivilege could not be enabled; files written by a container may not be removable"
+
 let hostname = "builder"
 let username = "ContainerAdministrator"
 
