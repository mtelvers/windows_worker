diff -ruN day10-base/bin/day10_stubs.c day10-wt/bin/day10_stubs.c
--- a/bin/day10_stubs.c	1970-01-01 00:00:00.000000000 +0000
+++ b/bin/day10_stubs.c	2026-11-05 14:55:41.747882166 +0000
@@ -0,0 +1,48 @@
+/* Enable SeBackupPrivilege and SeRestorePrivilege in day10's own token.
+
+   What a container writes into the bind-mounted opam root does not inherit
+   the host directory's ACL: opam's Cygwin setup gives each file an explicit
+   DACL naming ContainerAdministrator as owner with Administrators and
+   Everyone read-only, so from the host neither Administrator nor SYSTEM may
+   delete it or clear its attributes.  With SeRestorePrivilege enabled the
+   kernel lets DeleteFile and SetFileAttributes through regardless, and
+   SeBackupPrivilege does the same for reading.  Administrators and SYSTEM hold
+   both privileges but disabled; an OpenSSH session enables them for its
+   children, which is the only reason day10 ever worked from one and not as a
+   service. */
+#include <caml/mlvalues.h>
+
+#ifdef _WIN32
+#include <windows.h>
+
+static int enable(LPCWSTR name)
+{
+  HANDLE token;
+  TOKEN_PRIVILEGES tp;
+  int ok;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token))
+    return 0;
+  ok = LookupPrivilegeValueW(NULL, name, &tp.Privileges[0].Luid);
+  if (ok) {
+    tp.PrivilegeCount = 1;
+    tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    /* AdjustTokenPrivileges succeeds even when the privilege is not held;
+       GetLastError says whether it was actually enabled. */
+    ok = AdjustTokenPrivileges(token, FALSE, &tp, 0, NULL, NULL) && GetLastError() == ERROR_SUCCESS;
+  }
+  CloseHandle(token);
+  return ok;
+}
+
+value day10_enable_backup_privileges(value unit)
+{
+  int backup = enable(L"SeBackupPrivilege");
+  int restore = enable(L"SeRestorePrivilege");
+  return Val_bool(backup && restore);
+}
+#else
+value day10_enable_backup_privileges(value unit)
+{
+  return Val_false;
+}
+#endif
