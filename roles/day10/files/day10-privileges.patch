diff -ruN day10-base/bin/windows.ml day10-wt/bin/windows.ml
--- a/bin/windows.ml	2026-11-05 14:12:53.000000000 +0000
+++ b/bin/windows.ml	2026-11-05 14:55:01.173758953 +0000
@@ -4,6 +4,15 @@
