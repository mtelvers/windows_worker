diff -ruN -x _build head-e714603/bin/cleanup.ml head-final/bin/cleanup.ml
--- a/bin/cleanup.ml	2026-11-06 12:25:03.000000000 +0000
+++ b/bin/cleanup.ml	2026-11-06 17:39:51.843296665 +0000
@@ -41,7 +41,20 @@
   let previous = List.map (fun (signal, _) -> (signal, Sys.signal signal Sys.Signal_ignore)) signals in
   Fun.protect ~finally:(fun () -> List.iter (fun (signal, behaviour) -> Sys.set_signal signal behaviour) previous) f
 
-let with_resource (release : t) f = Fun.protect ~finally:(fun () -> uninterruptible release) f
+(* A pending signal can fire at the very start of the finaliser, before
+   uninterruptible has masked anything, and the release is then skipped.  On
+   Windows that is the usual place for it: a blocking call there is not
+   interrupted, so the signal waits for it to return and fires at the next
+   safe point.  Fun.protect reports exactly that case as Finally_raised, so
+   release once more on the way out.  The handler ignores every further
+   signal, so this release cannot be cut short; releases are best effort and
+   quiet, so one that had already run does no harm. *)
+let with_resource (release : t) f =
+  match Fun.protect ~finally:(fun () -> uninterruptible release) f with
+  | v -> v
+  | exception (Fun.Finally_raised _ as e) ->
+      release ();
+      raise e
 
 (* Raising from the handler rather than exiting is what lets the finalisers run.
    The exception surfaces at the next safe point, which is as soon as the signal
diff -ruN -x _build head-e714603/bin/day10_stubs.c head-final/bin/day10_stubs.c
--- a/bin/day10_stubs.c	1970-01-01 00:00:00.000000000 +0000
+++ b/bin/day10_stubs.c	2026-11-06 13:31:06.948624922 +0000
@@ -0,0 +1,39 @@
+/* Deliver Ctrl-Break as SIGINT.
+
+   The C runtime's console handler raises SIGINT for Ctrl-C but SIGBREAK for
+   Ctrl-Break, and OCaml knows nothing of SIGBREAK, so Ctrl-Break kills day10
+   outright without running its finalisers.  OCaml 4.14 mapped both events to
+   SIGINT in caml_win32_signal (runtime/win32.c); OCaml 5 still defines that
+   function but no longer routes Sys.set_signal through it.
+
+   Ctrl-Break matters because it is the only console event that can be sent
+   to a single process group: ocluster-worker starts each day10 job in its
+   own group and cancels it with GenerateConsoleCtrlEvent(CTRL_BREAK_EVENT).
+
+   Re-raising rather than calling caml_record_signal directly leaves the
+   decision to whatever SIGINT disposition day10 has set: OCaml's handler
+   records it, an ignore drops it, and the default exits as before.  The C
+   runtime resets a handler to SIG_DFL before calling it, hence re-arming. */
+#include <caml/mlvalues.h>
+
+#ifdef _WIN32
+#include <signal.h>
+
+static void break_to_int(int sig)
+{
+  (void) sig;
+  signal(SIGBREAK, break_to_int);
+  raise(SIGINT);
+}
+
+value day10_route_ctrl_break(value unit)
+{
+  signal(SIGBREAK, break_to_int);
+  return Val_unit;
+}
+#else
+value day10_route_ctrl_break(value unit)
+{
+  return Val_unit;
+}
+#endif
