 (* The newest opam whose root the opam libraries in day10-install still read:
    2.6 bumped the root format, 2.3 to 2.5 write the one 2.2 introduced. *)
+(* See day10_stubs.c: Ctrl-Break, which is how ocluster-worker cancels a job,
+   reaches Cleanup's SIGINT handler like Ctrl-C does. *)
+external route_ctrl_break : unit -> unit = "day10_route_ctrl_break"
+
+let () = if Sys.win32 then route_ctrl_break ()
+
